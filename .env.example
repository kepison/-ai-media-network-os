# AI Media Network OS — environment
# Копируйте в .env и заполните. Никогда не коммитьте .env.

# Порт приложения
PORT=4130
HOST=127.0.0.1

# Путь к БД (по умолчанию data/ai-media-os.db)
# DB_PATH=./data/ai-media-os.db

# OpenRouter (опционально) — включит облачные модели
# Получить ключ: https://openrouter.ai/keys
# Внимание: в AI Brain можно добавлять сразу несколько ключей через UI (Settings → API Keys).
OPENROUTER_API_KEY=

# Gemini API Free Tier (опционально, второй бесплатный fallback после Ollama)
# Получить ключ: https://aistudio.google.com/apikey (Free Tier достаточно)
# ⚠️ РУЧНОЕ ДЕЙСТВИЕ: скопируйте ваш ключ в файл .env рядом с этим файлом:
#   1) cp .env.example .env
#   2) впишите GEMINI_API_KEY=AIza...  (и OPENROUTER_API_KEY=sk-or-... при желании)
GEMINI_API_KEY=

# Локальные модели через Ollama (бесплатно)
# Уже настроен: base_url http://127.0.0.1:11434, модель qwen2.5:7b
# Установка: ollama pull qwen2.5:7b